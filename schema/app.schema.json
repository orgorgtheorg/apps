{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrgOrg app manifest (apps/<id>/app.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appId",
    "version",
    "name",
    "tagline",
    "who",
    "how",
    "category",
    "connectors",
    "setupMinutes",
    "adds"
  ],
  "properties": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable id; must equal the folder name."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump on any meaningful change."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "One-line job description shown on the marketplace card."
    },
    "who": {
      "type": "string",
      "minLength": 1,
      "description": "The concrete person/business this is for."
    },
    "how": {
      "type": "string",
      "minLength": 1,
      "description": "How it concretely works — mechanism + outcome."
    },
    "category": {
      "enum": ["growth", "operations", "build", "general"]
    },
    "accent": {
      "type": "string",
      "description": "Card tint, an oklch() color."
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "required"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "setupMinutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "adds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crons", "apps"],
      "properties": {
        "crons": { "type": "array", "items": { "type": "string" } },
        "apps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
